# CivicPulse AI - Backend Production Environment Template

# Server Bind Configuration
HOST=0.0.0.0
PORT=8000

# Base URLs
PUBLIC_BASE_URL=https://civicpulse-ai-git-main-hackpulse.vercel.app
API_BASE_URL=http://localhost:8000

# Production CORS - Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://civicpulse-ai-git-main-hackpulse.vercel.app,https://civicpulse-q9phsg9cc-hackpulse.vercel.app,https://civicpulse-ai.vercel.app

# Ollama AI Engine Configuration
# For local machine: http://localhost:11434
# For container/cloud: http://ollama:11434 or your private Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=bge-m3
SIMILARITY_THRESHOLD=0.70

# Security Secrets (replace with strong random strings in production)
TOKEN_SECRET=replace_with_strong_random_secret_token
JWT_SECRET=replace_with_strong_random_jwt_secret

# Default Initial Administrator Credentials
ADMIN_EMAIL=admin@civicpulse.gov
ADMIN_PASSWORD=replace_with_secure_admin_password

# SLA & Demo Mode Settings
# Set to 'false' in real municipal production (enables 30m ack / 72h resolution SLAs)
DEMO_MODE=true

# Outbound SMTP Mail Dispatch (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME=CivicPulse AI Desk
